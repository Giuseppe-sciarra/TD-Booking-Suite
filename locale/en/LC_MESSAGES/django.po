msgstr "Hello {nome},\nsee you soon: {servizio}, {quando}.\nIf you cannot come, manage or cancel: {link}"

msgid "Prima del tuo arrivo · {attivita}"
msgstr "Before your arrival · {attivita}"

msgid "Ciao {nome},\nti aspettiamo: {servizio}, {quando}.\n{istruzioni}\nPer gestire la prenotazione: {link}"
msgstr "Hello {nome},\nwe look forward to seeing you: {servizio}, {quando}.\n{istruzioni}\nTo manage your booking: {link}"

msgid "Com'è andata? · {attivita}"
msgstr "How did it go? · {attivita}"

msgid "Ciao {nome},\ngrazie di aver scelto {attivita}. Se ti va, lasciaci una recensione: per noi conta molto."
msgstr "Hello {nome},\nthank you for choosing {attivita}. If you like, leave us a review: it means a lot to us."

msgid "Si è liberato un posto · {attivita}"
msgstr "A place is free · {attivita}"

msgid "Ciao {nome},\nsi è liberato un posto che aspettavi: {servizio}, {quando}.\nPrenota da qui: {link}"
msgstr "Hello {nome},\na place you were waiting for is free: {servizio}, {quando}.\nBook here: {link}"

