msgid "Ciao {nome},\nti ricordiamo la prenotazione: {servizio}, {quando}.\nSe non puoi venire, gestisci o annulla: {link}"
msgstr "Hello {nome},\na reminder of your booking: {servizio}, {quando}.\nIf you cannot come, manage or cancel: {link}"

