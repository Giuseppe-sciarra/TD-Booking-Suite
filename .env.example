# Generare .env con scripts/configure.py; nessuna credenziale predefinita.
# SMTP transazionale opzionale:
# TRANSACTIONAL_SMTP_HOST=smtp.fornitore.it
# TRANSACTIONAL_SMTP_PORT=587
# TRANSACTIONAL_SMTP_USER=utente
# TRANSACTIONAL_SMTP_PASSWORD=segreto
# TRANSACTIONAL_FROM=prenotazioni@tuodominio.it
# Accesso: con "Resta collegato" il dispositivo resta dentro per questi giorni dall'ultima visita (predefinito 30)
# TDBS_SESSION_REMEMBER_DAYS=30
